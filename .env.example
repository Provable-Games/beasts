############################################################
# Copy this file to .env and fill in ALL values below.
# The deploy script will fail if any are missing.
############################################################

# Starknet account details (required)
STARKNET_ACCOUNT="<starkli-account-address>"
STARKNET_PRIVATE_KEY="<starkli-private-key-hex>"

# Network RPC (required)
# e.g., Sepolia: https://api.cartridge.gg/x/starknet/sepolia
#        Mainnet: https://<your-mainnet-rpc>
RPC_URL="<rpc-url>"

# NFT constructor params (required)
NAME="<collection-name>"
SYMBOL="<collection-symbol>"

# Owner and royalty configuration (required)
OWNER="<owner-address>"
ROYALTY_RECEIVER="<royalty-receiver-address>"
ROYALTY_FRACTION="<u128-fraction>" # e.g., 500 = 5% (denominator 10,000)

# Terminal behavior (optional)
# UNIX timestamp in seconds after which token_uri should be disabled.
# Set to 0 to disable terminal behavior and keep token_uri active indefinitely.
TERMINAL_TIMESTAMP="0"

# External systems integration (optional)
# Set to a contract address to enable Death Mountain integration; use 0 to disable
DEATH_MOUNTAIN_ADDRESS="0"

############################################################
# Black Shuck sncast deploy settings (scripts/deploy_black_shuck.sh)
############################################################

# sncast profile in snfoundry.toml, used for the RPC url and wait settings.
# Defaults to "default" when omitted.
SNCAST_PROFILE="default"
SEPOLIA_RPC_URL="<sepolia-rpc-url>"
MAINNET_RPC_URL="<mainnet-rpc-url>"

# Signing uses a starkli-style keystore + account pair. These are the script's own defaults,
# shown here for visibility. A leading ~ is expanded by the script.
KEYSTORE="~/.starknet_accounts/keystore.json"
ACCOUNT_FILE="~/.starknet_accounts/account.json"

# The keystore is encrypted; leave KEYSTORE_PASSWORD unset and sncast prompts once per run.
# KEYSTORE_PASSWORD=""

# The deploy reads NAME / SYMBOL / OWNER / MINTER_ADDRESS / ROYALTY_RECEIVER /
# ROYALTY_FRACTION, and each may also be given with a BLACK_SHUCK_ prefix, which wins when set.
BLACK_SHUCK_NAME="Black Shuck"
BLACK_SHUCK_SYMBOL="SHUCK"
# BLACK_SHUCK_OWNER="<owner-address>"

# Festival claim contract, authorised to call mint().
BLACK_SHUCK_MINTER_ADDRESS="0x06ef7b83398d045cA3D71e1533ab899cDda3B38cC26e6863610eD64Ff50D125f"

# Secondary-sale royalties (ERC2981). The fraction is denominated in 10,000, so 500 = 5%.
# Both are changeable after deploy by the owner.
BLACK_SHUCK_ROYALTY_RECEIVER="0x041bb7729efa185f2cab327de0a668886302f1d4969e3edf504c4741648f858b"
BLACK_SHUCK_ROYALTY_FRACTION="500"

# Notes:
# - Do NOT commit your real STARKNET_PRIVATE_KEY. This file is provided as an example.
# - Copy to .env and fill in all required variables before running deploy scripts.
